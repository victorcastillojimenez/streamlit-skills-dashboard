# Copia este archivo a .streamlit/secrets.toml para configurar credenciales externas.
# NUNCA subas secrets.toml al repositorio — está en .gitignore.
#
# La aplicación base no consume ningún secreto: todos los datos son simulados.
# Añade aquí las claves de los servicios que integres al extender la plantilla.
#
# Ejemplo:
# [api]
# openai_key = "TU_CLAVE_AQUI"
#
# [database]
# url = "TU_CLAVE_AQUI"
